{
  "name": "@marl1w/scrypted-stamina",
  "version": "0.1.5",
  "description": "Scrypted plugin that turns every camera's detections into events with subjects and verdicts, cuts fMP4 segments from the prebuffer at the first detection, and serves them, clips and recordings to the Scrypted Stamina Home Assistant integration over HTTP.",
  "license": "MIT",
  "scripts": {
    "scrypted-setup-project": "scrypted-setup-project",
    "prescrypted-setup-project": "scrypted-package-json",
    "build": "scrypted-webpack",
    "prepublishOnly": "NODE_ENV=production scrypted-webpack",
    "scrypted-deploy": "scrypted-deploy",
    "scrypted-deploy-debug": "scrypted-deploy-debug",
    "scrypted-debug": "scrypted-debug",
    "scrypted-package-json": "scrypted-package-json",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf out-test && tsc -p tsconfig.test.json && node --test out-test/test/*.test.js"
  },
  "keywords": [
    "scrypted",
    "plugin",
    "events",
    "home-assistant",
    "hls"
  ],
  "scrypted": {
    "rollup": true,
    "name": "Scrypted Stamina",
    "type": "API",
    "interfaces": [
      "Settings",
      "MixinProvider",
      "HttpRequestHandler"
    ],
    "pluginDependencies": []
  },
  "dependencies": {
    "@scrypted/sdk": "^0.5.59"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.6.0"
  },
  "author": "marl1w",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/marl1w/scrypted-stamina-ha.git"
  },
  "homepage": "https://github.com/marl1w/scrypted-stamina-ha#readme",
  "bugs": {
    "url": "https://github.com/marl1w/scrypted-stamina-ha/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "README.md",
    "package.json"
  ]
}
